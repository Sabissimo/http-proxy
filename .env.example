# Copy to .env next to httpproxy.exe and fill in. Real environment variables
# override the file.

# Upstream every request is forwarded to (required). A path here is prefixed
# to every request path: TARGET=https://host/app sends /x to https://host/app/x.
TARGET=https://new.example.com

# Port the proxy listens on (default 7777).
PORT=7777

# Verify the upstream's TLS certificate (default false: any certificate is
# accepted, for internal hosts with self-signed ones).
#SECURE=false

# How long to wait for the upstream to start answering, in milliseconds
# (default 60000, 0 = no limit). Streamed responses and WebSockets are never
# cut off by it. No answer in time -> 502.
#PROXY_TIMEOUT_MS=60000

# Log one line per request: method, URL, status, duration, client (default
# false). Startup, upstream errors and shutdown are always logged.
#LOGGING=false

# Answered by the proxy itself with 200 "ok" (GET/HEAD), without touching the
# upstream — ElvareConsole checks /healthz after a deploy. "off" forwards this
# path to the upstream like any other.
#HEALTH_PATH=/healthz

# Service logs: one file per day, httpproxy-YYYY-MM-DD.log, in LOG_DIR
# (default: the "logs" folder next to the exe; a relative path is taken
# relative to the exe's folder). Files older than LOG_KEEP_DAYS are deleted
# (default 30, 0 = keep all). Console runs log to the console instead.
#LOG_DIR=D:\Logs\HttpProxy
#LOG_KEEP_DAYS=30

# Windows service registration (optional). Used by `service install` and by
# start/stop/uninstall to find it again; --name / --display-name /
# --description flags override these. Defaults: HttpProxy, "HTTP Proxy", and
# a one-line description.
#SERVICE_NAME=HttpProxy
#SERVICE_DISPLAY_NAME=HTTP Proxy
#SERVICE_DESCRIPTION=Reverse proxy forwarding every request to TARGET
